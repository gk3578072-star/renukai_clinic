PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/renukai_dental_clinic
JWT_SECRET=replace-with-at-least-32-random-characters
CLIENT_ORIGIN=http://localhost:5173
OTP_PROVIDER=dev
DEV_OTP_LOG=true
TWILIO_ACCOUNT_SID=AC_replace_with_account_sid
TWILIO_AUTH_TOKEN=replace_with_auth_token
TWILIO_VERIFY_SERVICE_SID=VA_replace_with_verify_service_sid
ADMIN_PHONES=
# Set to the exact number of trusted reverse-proxy hops; leave unset for direct access.
TRUST_PROXY=
